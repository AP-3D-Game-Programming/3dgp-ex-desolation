--- !u!114 &3142322289682237361
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8089066842637007531}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fde912e761b7bed44b1e8695e4f7966f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteHandler
  NoteCanvas: {fileID: 494261224126116646}
  NoteTextMesh: {fileID: 8549814790782443104}
  playerCamera: {fileID: 463586366}
  itemOverlayCanvas: {fileID: 1915894790}
  itemLookedAtText: {fileID: 364793791}
  NoteText: 'Listen closely, I''m running out of time. I''ve been trapped here for
    weeks. That damn door... the handle is rusted solid. It won''t budge.  I tried
    everything. I thought I had to mix a complex acid in my test tubes to melt the
    metal. I wasted days on formulas. But I was wrong.  It doesn''t work as a mixture.
    You need three specific items and you have to pour them <color=red> directly
    on the rusted handle</color> in the correct order. One by one. Three back to
    back reactions to break through the corrosion. I wasted my last strength mixing
    useless concoctions. Don''t make the same mistake. Find all three and smash them
    against that rust. The rust reacts interesting when the right ingredient is added. '
  playerMovementScript: {fileID: 2934462364720062533}
  activeSceneName: 5_chemlab_puzzle
